{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raiz",
  "compatibility_date": "2026-11-13",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "raiz.marcio.run", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
