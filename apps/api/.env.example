# Copy to .env (gitignored) and adjust if needed. Never commit a real secret.
ENV=development
ADDR=:8080
LOG_LEVEL=info

DATABASE_URL=postgres://raiz:raiz@localhost:5432/raiz?sslmode=disable

# Required, at least 16 characters. Replace in production (fly secrets / platform env).
JWT_SECRET=dev-only-secret-change-me-please

# Required, at least 32 characters. Seeds the phone hash (HMAC) and phone_enc
# (AES-256-GCM). The value below is a fake dev key: never use it in production.
PII_KEY=dev-only-pii-key-not-a-secret-32ch

# Demo mode: fixed OTP 000000 and seed data labelled as demo in the UI.
DEMO_MODE=true

# "*" allows everything (dev). In production list the origins:
# ALLOWED_ORIGINS=https://raiz.app,https://www.raiz.app
ALLOWED_ORIGINS=*

# Optional. Empty means the server looks for ../../docs/openapi.yaml.
CONTRACT_PATH=
